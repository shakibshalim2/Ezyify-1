{
  "name": "ezyify-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo run dev --filter=@ezyify/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=@ezyify/web",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web": "pnpm --filter @ezyify/web",
    "core": "pnpm --filter @ezyify/core",
    "tokens": "pnpm --filter @ezyify/tokens",
    "api": "pnpm --filter @ezyify/api"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "~5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "@tailwindcss/oxide",
      "argon2",
      "esbuild",
      "msw",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "uuid@<11.1.1": ">=11.1.1",
      "decode-uri-component@<0.5.0": ">=0.5.0",
      "mysql2@<3.23.1": ">=3.23.1",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    },
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
