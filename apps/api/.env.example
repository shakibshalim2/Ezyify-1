NODE_ENV=development
PORT=4000
API_PREFIX=v1
DATABASE_URL=postgresql://ezyify:ezyify@localhost:5432/ezyify?schema=public
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,https://ezyify.app
COOKIE_DOMAIN=
# openssl rand -base64 32 — AES-256-GCM key for TOTP secrets at rest. Required in production; derived from JWT_REFRESH_SECRET elsewhere.
MFA_ENCRYPTION_KEY=
ESCROW_AUTO_RELEASE_DAYS=7
PLATFORM_FEE_BPS=500
# Optional providers — every one of these degrades gracefully when unset (see README "Providers")
# Firebase service-account JSON (single line) → FCM HTTP v1 push. Unset → push is logged only.
FCM_SERVICE_ACCOUNT_JSON=
# Resend → OTP / password-reset email. Unset → codes logged in non-production only.
RESEND_API_KEY=
MAIL_FROM=Ezyify <no-reply@ezyify.app>
# Base URL used in password-reset links
WEB_APP_URL=https://ezyify.app
# Meilisearch → typo-tolerant /search (indexes products/users/posts). Unset → Postgres ILIKE fallback.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
# LiveKit → /live/token + /live/call-token. Unset → 503 LIVE_UNAVAILABLE. Key requires secret + url.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Object storage for user uploads (S3 / R2 / MinIO). Unset → upload endpoints return "Storage unavailable".
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
