# Copy to android/keystore.properties (git-ignored) — or export EZYIFY_UPLOAD_* env vars in CI.
# Generate the upload key once (keep it out of git, back it up):
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/ezyify-upload.keystore \
#     -alias ezyify-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=ezyify-upload.keystore
storePassword=CHANGE_ME
keyAlias=ezyify-upload
keyPassword=CHANGE_ME
