# Base URL of apps/api (production build points at the real API).
VITE_API_BASE_URL=http://localhost:4000/v1
# `mock` runs the in-process mock API from @ezyify/core/mock (same fixtures as the mobile demo build) — used by
# Playwright in CI and for offline previews. Leave unset for a real backend.
VITE_API_MODE=
# Observability (all optional; nothing loads when unset). Product analytics only run after cookie consent.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Release tag attached to Sentry events (CI sets this to the git SHA).
VITE_APP_VERSION=
