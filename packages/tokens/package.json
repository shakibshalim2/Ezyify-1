{
  "name": "@ezyify/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Ezyify design tokens \u2014 one JSON source rendered to CSS variables (web) and a typed theme (React Native)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./tokens.json",
    "./css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "build": "node scripts/sync-json.mjs && tsc -p tsconfig.json && node scripts/build-css.mjs",
    "typecheck": "node scripts/sync-json.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint for tokens'",
    "test": "node --test test/*.test.mjs",
    "sync": "node scripts/sync-json.mjs"
  },
  "devDependencies": {
    "@ezyify/config": "workspace:*",
    "typescript": "~5.7.2"
  }
}
