{
  "$schema": "./tokens.schema.json",
  "meta": { "name": "Ezyify", "version": 1, "source": "logo-mark.png sampled colours" },
  "palette": {
    "blue": { "50": "#eaf3ff", "100": "#d3e5ff", "200": "#a9caff", "300": "#74a9fb", "400": "#3f86f0", "500": "#1a6fdc", "600": "#0f66c7", "700": "#0c52a2", "800": "#0b437f", "900": "#0a3663", "950": "#061f3d" },
    "orange": { "50": "#fff3eb", "100": "#ffe2d0", "200": "#ffc4a3", "300": "#ff9f6b", "400": "#ff8442", "500": "#ff6f22", "600": "#e85a12", "700": "#c1460d", "800": "#99380f", "900": "#7a2f10" },
    "violet": { "500": "#7c5cff", "400": "#9b85ff" },
    "white": "#ffffff",
    "black": "#000000"
  },
  "color": {
    "light": {
      "background": "#f8f9fc",
      "backgroundElevated": "#ffffff",
      "backgroundSubtle": "#f3f4f8",
      "overlay": "rgba(0, 0, 0, 0.4)",
      "foreground": "#0d0f1a",
      "foregroundSecondary": "#6b7280",
      "foregroundTertiary": "#9ca3af",
      "card": "#ffffff",
      "muted": "#f3f4f8",
      "border": "#e5e7ef",
      "borderStrong": "#d1d5db",
      "borderSubtle": "#f0f1f5",
      "primary": "{palette.blue.600}",
      "primaryHover": "{palette.blue.700}",
      "primaryActive": "{palette.blue.800}",
      "primaryForeground": "#ffffff",
      "primarySubtle": "{palette.blue.50}",
      "accent": "{palette.orange.500}",
      "accentHover": "{palette.orange.600}",
      "accentForeground": "#ffffff",
      "accentSubtle": "{palette.orange.50}",
      "success": "#059669",
      "successSubtle": "#ecfdf5",
      "warning": "#d97706",
      "warningSubtle": "#fffbeb",
      "error": "#dc2626",
      "errorSubtle": "#fef2f2",
      "info": "#2563eb",
      "infoSubtle": "#eff6ff",
      "ring": "{palette.blue.500}"
    },
    "dark": {
      "background": "#0a0d14",
      "backgroundElevated": "#10141d",
      "backgroundSubtle": "#0d1119",
      "overlay": "rgba(0, 0, 0, 0.6)",
      "foreground": "#f5f6fa",
      "foregroundSecondary": "#9ca3af",
      "foregroundTertiary": "#6b7280",
      "card": "#10141d",
      "muted": "#161b27",
      "border": "#222938",
      "borderStrong": "#2f3849",
      "borderSubtle": "#161b27",
      "primary": "{palette.blue.400}",
      "primaryHover": "{palette.blue.300}",
      "primaryActive": "{palette.blue.500}",
      "primaryForeground": "#ffffff",
      "primarySubtle": "#0f1f3a",
      "accent": "{palette.orange.400}",
      "accentHover": "{palette.orange.300}",
      "accentForeground": "#1a0d05",
      "accentSubtle": "#2b170c",
      "success": "#34d399",
      "successSubtle": "#052e1f",
      "warning": "#fbbf24",
      "warningSubtle": "#2a1e05",
      "error": "#f87171",
      "errorSubtle": "#2f0d0d",
      "info": "#60a5fa",
      "infoSubtle": "#0b1a33",
      "ring": "{palette.blue.400}"
    }
  },
  "gradient": {
    "brand": ["{palette.blue.500}", "{palette.blue.700}"],
    "brandDark": ["{palette.blue.400}", "{palette.blue.600}"],
    "vivid": ["{palette.blue.400}", "{palette.blue.600}", "{palette.violet.500}"],
    "warm": ["{palette.orange.400}", "{palette.orange.500}"]
  },
  "typography": {
    "family": { "base": "Inter", "display": "Plus Jakarta Sans" },
    "size": { "xs": 12, "sm": 14, "base": 15, "md": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36, "5xl": 48 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.15, "snug": 1.3, "normal": 1.5 }
  },
  "radius": { "sm": 8, "md": 12, "card": 16, "sheet": 24, "pill": 9999 },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "layout": { "navHeight": 64, "headerHeight": 56, "touchTarget": 44, "gutter": 16 },
  "motion": {
    "duration": { "instant": 100, "fast": 160, "normal": 240, "slow": 360, "slower": 600 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "emphasized": [0.05, 0.7, 0.1, 1],
      "exit": [0.3, 0, 0.8, 0.15],
      "spring": [0.34, 1.56, 0.64, 1]
    },
    "spring": { "soft": { "stiffness": 260, "damping": 26, "mass": 0.9 }, "snappy": { "stiffness": 420, "damping": 30 } }
  },
  "shadow": {
    "brand": { "color": "{palette.blue.600}", "opacity": 0.28, "y": 4, "blur": 14 },
    "brandLg": { "color": "{palette.blue.600}", "opacity": 0.4, "y": 10, "blur": 30 },
    "orange": { "color": "{palette.orange.500}", "opacity": 0.4, "y": 6, "blur": 18 }
  }
}
